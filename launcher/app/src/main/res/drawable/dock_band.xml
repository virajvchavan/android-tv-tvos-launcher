<?xml version="1.0" encoding="utf-8"?>
<!-- Smoky dark glass: darkens bright wallpapers like the tvOS dock, yet still reads as a faint band on plain black. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="#8C141418"
        android:startColor="#73303036" />
    <stroke android:width="1dp" android:color="#24FFFFFF" />
    <corners android:radius="24dp" />
</shape>
