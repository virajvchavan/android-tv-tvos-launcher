<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <SurfaceView
        android:id="@+id/wallpaper_video"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <View
        android:id="@+id/wallpaper_tint"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#4D000000"
        android:visibility="gone" />

    <View
        android:id="@+id/glow"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false"
        android:overScrollMode="never"
        android:scrollbars="none">

        <FrameLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/top_area"
                    android:layout_width="match_parent"
                    android:layout_height="540dp"
                    android:clipChildren="false">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="49dp"
                        android:layout_marginTop="34dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/greeting"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#A1A1A6"
                            android:textSize="17sp" />

                        <TextView
                            android:id="@+id/clock"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="-3dp"
                            android:includeFontPadding="false"
                            android:letterSpacing="-0.02"
                            android:textColor="#FFFFFF"
                            android:textSize="84sp" />

                        <TextView
                            android:id="@+id/date"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#A1A1A6"
                            android:textSize="17sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="42dp"
                        android:layout_marginEnd="49dp"
                        android:clipChildren="false"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/pill_inputs"
                            style="@style/Pill"
                            android:drawableStart="@drawable/ic_input"
                            android:text="@string/inputs" />

                        <TextView
                            android:id="@+id/pill_wifi"
                            style="@style/Pill"
                            android:drawableStart="@drawable/ic_wifi"
                            android:text="@string/wifi" />

                        <TextView
                            android:id="@+id/pill_wallpaper"
                            style="@style/Pill"
                            android:drawableStart="@drawable/ic_wallpaper"
                            android:text="@string/wallpaper" />

                        <TextView
                            android:id="@+id/pill_settings"
                            style="@style/Pill"
                            android:drawableStart="@drawable/ic_settings"
                            android:text="@string/settings" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/dock_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|start"
                        android:layout_marginStart="49dp"
                        android:layout_marginBottom="143dp"
                        android:alpha="0"
                        android:textColor="#F5F5F7"
                        android:textSize="40sp" />

                    <LinearLayout
                        android:id="@+id/dock"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:layout_marginStart="23dp"
                        android:layout_marginEnd="23dp"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/dock_band"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:orientation="horizontal"
                        android:paddingStart="13dp"
                        android:paddingTop="13dp"
                        android:paddingEnd="13dp"
                        android:paddingBottom="13dp" />
                </FrameLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/grid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:descendantFocusability="blocksDescendants"
                    android:focusable="false"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    android:paddingStart="36dp"
                    android:paddingEnd="36dp"
                    android:paddingBottom="96dp" />
            </LinearLayout>

            <View
                android:id="@+id/highlight"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_gravity="top|start"
                android:alpha="0" />
        </FrameLayout>
    </ScrollView>

    <TextView
        android:id="@+id/move_hint"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="10dp"
        android:background="@drawable/pill"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:text="@string/move_hint"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/menu_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:background="@drawable/glass_panel"
        android:focusable="false"
        android:overScrollMode="never"
        android:padding="6dp"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/menu_rows"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="230dp"
            android:orientation="vertical" />
    </ScrollView>
</FrameLayout>
